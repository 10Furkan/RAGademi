# Anthropic API key. Leave empty when using a subscription or demo backend.
ANTHROPIC_API_KEY=

# Needed only when publishing the site with Docker Compose.
# Point this hostname's DNS A/AAAA record to your server first.
DOMAIN=ragademi.example.com
# Choose a long, unique password. The private library uses username "admin".
DERSNOTU_ADMIN_PASSWORD=

# Main generation model: claude-sonnet-5 (default) | claude-opus-5 (premium)
DERSNOTU_MODEL=claude-sonnet-5
# Inexpensive model for classification and topic-card passes
DERSNOTU_CHEAP_MODEL=claude-haiku-4-5
# low | medium | high | xhigh | max
DERSNOTU_EFFORT=high

# Directory for indexes and intermediate output
DERSNOTU_CACHE_DIR=.cache
# Default local library. Set to postgres only with all cloud settings below.
DERSNOTU_LIBRARY_BACKEND=sqlite
# Supabase Connect -> Session pooler URL (port 5432); password must be URL-encoded.
DERSNOTU_DATABASE_URL=
# Optional Supabase database root certificate downloaded from Database settings.
# Render: add a secret file and use /etc/secrets/supabase-ca.crt here.
DERSNOTU_DATABASE_SSL_CA_FILE=
# Supabase Storage -> S3: copy endpoint, region and generated S3 credentials.
# Create a PRIVATE bucket named ragademi. Never put these secrets in Vercel.
DERSNOTU_S3_ENDPOINT=
DERSNOTU_S3_REGION=
DERSNOTU_S3_BUCKET=ragademi
DERSNOTU_S3_ACCESS_KEY=
DERSNOTU_S3_SECRET_KEY=
# Supabase Free supports 50 MB per object. Render Blueprint also limits uploads.
DERSNOTU_S3_MAX_FILE_MB=50
# Render Free uses one generation worker to reduce memory pressure.
DERSNOTU_MAX_WORKERS=2
# Optional Codex CLI model override. Leave empty to use the Codex default.
# Sign in for subscription access with: codex login
DERSNOTU_CODEX_MODEL=
