# Anthropic API anahtarı. `ant auth login` kullanıyorsan boş bırakabilirsin.
ANTHROPIC_API_KEY=

# Genişletme motoru: claude-sonnet-5 (varsayılan) | claude-opus-5 (premium)
DERSNOTU_MODEL=claude-sonnet-5
# Ucuz sınıflandırma/konu-kartı geçişi
DERSNOTU_CHEAP_MODEL=claude-haiku-4-5
# low | medium | high | xhigh | max
DERSNOTU_EFFORT=high

# İndeks ve ara çıktıların yazıldığı dizin
DERSNOTU_CACHE_DIR=.cache
