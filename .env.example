# Anthropic API key. Leave empty when using a subscription or demo backend.
ANTHROPIC_API_KEY=

# Main generation model: claude-sonnet-5 (default) | claude-opus-5 (premium)
DERSNOTU_MODEL=claude-sonnet-5
# Inexpensive model for classification and topic-card passes
DERSNOTU_CHEAP_MODEL=claude-haiku-4-5
# low | medium | high | xhigh | max
DERSNOTU_EFFORT=high

# Directory for indexes and intermediate output
DERSNOTU_CACHE_DIR=.cache
# Optional Codex CLI model override. Leave empty to use the Codex default.
# Sign in for subscription access with: codex login
DERSNOTU_CODEX_MODEL=
